# Copy this file to .streamlit/secrets.toml for local Streamlit secrets.
# Do not commit the real secrets.toml file.

THE_ODDS_API_KEY = "your_the_odds_api_key_here"

# Optional permanent app storage using your GitHub repo.
# Create a fine-grained token with Contents: Read and write for this repo only.
GITHUB_STORAGE_TOKEN = "github_pat_or_fine_grained_token_here"
GITHUB_STORAGE_REPO = "goldstarpalms-svg/Sekta-cup"
# Use a branch Streamlit is NOT deployed from, to avoid redeploy on every save.
GITHUB_STORAGE_BRANCH = "app-storage"
GITHUB_STORAGE_PREFIX = "data/app_state"

# Optional future integrations
PINNACLE_USERNAME = "your_pinnacle_username"
PINNACLE_PASSWORD = "your_pinnacle_password"
BETFAIR_APP_KEY = "your_betfair_app_key"
BETFAIR_SESSION_TOKEN = "your_betfair_session_token"
